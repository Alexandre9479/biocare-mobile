{
  "expo": {
    "name": "Biocare SMS",
    "slug": "biocare-service-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/biocare-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/biocare-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/biocare-logo.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.biocarehealthsystems.sms",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Biocare needs camera to scan QR codes and take service photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Biocare needs photo access to upload service images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "425bfd0e-801c-4e3a-a12a-f969afeedf3a"
      }
    },
    "owner": "alex9479"
  }
}
